<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Unterwasser Suchspiel - Finale Version</title>

  <style>
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: Arial, sans-serif;
      background-color: #00051a;
    }

    /* 🌊 Hintergrund-Container */
    .container {
      position: relative;
      width: 100vw;
      height: 100vh;
      cursor: none;
      background: url("Unterwasser.png.png") center/cover no-repeat;
    }

    /* 🌑 1. Ebene: Dunkelblaues Overlay */
    .dark-overlay {
      position: absolute;
      inset: 0;
      background: #001226; /* Dunkles Navy-Blau */
      z-index: 10;
      pointer-events: none;
      
      mask-image: radial-gradient(
        circle 140px at var(--x, 50%) var(--y, 50%),
        transparent 70%,
        black 71%
      );
      -webkit-mask-image: radial-gradient(
        circle 140px at var(--x, 50%) var(--y, 50%),
        transparent 70%,
        black 71%
      );
    }

    .dark-overlay.off { opacity: 0; }

    /* 🔦 2. Ebene: Der Lichtkegel */
    .light-cone {
      position: absolute;
      width: 200px; 
      height: 200px;
      left: var(--x);
      top: var(--y);
      background: linear-gradient(to bottom, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.6) 100%);
      clip-path: polygon(0% 0%, 100% 0%, 55% 100%, 45% 100%);
      transform: translateX(-50%);
      pointer-events: none;
      z-index: 11;
    }

    /* 🔦 3. Ebene: Lichtfleck auf dem Boden */
    .flashlight-spot {
      position: absolute;
      width: 250px; 
      height: 250px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 80%);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      pointer-events: none;
      transform: translate(-50%, -50%);
      left: var(--x);
      top: var(--y);
      z-index: 1000;
    }

    /* 🔦 4. Ebene: Die Taschenlampe (Grafik) */
    .flashlight-tool {
      position: absolute;
      width: 100px; /* Breite deiner Grafik */
      height: 150px;
      background: url("Tschenlampe cartoon.png") center/contain no-repeat;
      pointer-events: none;
      z-index: 20;
      left: var(--x);
      top: calc(var(--y) + 200px); /* Startet am Ende des 200px Kegels */
      transform: translate(-50%, -15px);
    }

    /* 🏷️ 5. Ebene: Das Logo (Ganz oben!) */
    .logo-container {
      position: absolute;
      top: 30px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000; /* Weit über dem Overlay */
      pointer-events: none;
    }

    .main-logo {
      width: 300px;
      height: auto;
      filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.4));
    }

    /* 🔎 Items */
    .item {
      position: absolute;
      opacity: 0;
      transition: opacity 0.2s;
      cursor: pointer;
      z-index: 15;
    }

    .item.found {
      opacity: 0 !important;
      pointer-events: none; /* Verhindert, dass man das unsichtbare Objekt nochmals anklicken kann */
    }

    /* 🏠 Home Button (Unten links) */
    .home-link {
      position: absolute;
      bottom: 20px;
      left: 20px;
      width: 110px;
      height: 110px;
      z-index: 1001; /* Über dem Logo */
      cursor: pointer !important;
    }

    .home-icon {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 0 10px white);
    }

    /* 🔌 UI */
    .switch {
      position: absolute;
      bottom: 20px; right: 20px;
      width: 60px; height: 100px;
      background: #eee; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; z-index: 100;
    }

    .toggle { width: 20px; height: 50px; background: #bbb; border-radius: 5px; transition: 0.2s; }
    .switch.on .toggle { transform: translateY(-15px); background: #4CAF50; }

    .score-wrapper {
      position: absolute;
      bottom: 30px; left: 50%;
      transform: translateX(-50%);
      padding: 10px; background: white;
      border-radius: 20px; z-index: 100;
      display: flex; gap: 10px;
    }

    /* 🛠️ HIER GEÄNDERT: Die Breite wurde von 80px auf 95px und die Höhe von 40px auf 55px vergrößert */
    .field { width: 70px; height: 60px; background: #eee; border: 1px solid #aaa; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-weight: bold; overflow: hidden; transition: background 0.3s, box-shadow 0.3s;}
    
    .field.filled { 
      background: #4CAF50; 
      border-color: #3e8e41;
    }
    
    .field img {
      width: 100%;
      height: 100%;
      object-fit: cover; 
      transition: filter 0.3s ease;
    }

    .field.filled img {
      filter: drop-shadow(0 0 5px white);
    }

    /* Container für Glühbirne und Sprechblase */
    .bulb-wrapper {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 1002;
      display: flex;
      align-items: flex-start;
      gap: 15px;
      pointer-events: none;
    }

    /* Design der echten CSS-Sprechblase */
    .speech-bubble {
      position: relative;
      background: rgba(255, 255, 255, 0.95);
      color: #333;
      padding: 12px 16px;
      border-radius: 15px;
      font-size: 14px;
      font-weight: bold;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      max-width: 220px;
      line-height: 1.4;
      margin-top: 10px;
      pointer-events: auto;
    }

    .speech-bubble::after {
      content: '';
      position: absolute;
      right: -10px;
      top: 20px;
      width: 0;
      height: 0;
      border-top: 8px solid transparent;
      border-left: 10px solid rgba(255, 255, 255, 0.95);
      border-bottom: 8px solid transparent;
    }

    /* Design für die Glühbirnen-Grafik */
    .bulb-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      pointer-events: auto;
    }

    .bulb-container img {
      width: 130px;
      height: auto;
      filter: drop-shadow(0 0 10px rgba(255, 235, 59, 0.5));
    }

    .off { opacity: 0 !important; }
  </style>
</head>
<body>

<div class="container" id="game-container">
  
  <div class="logo-container">
    <img src="Lichterlino_blau-gelb.png" alt="Logo" class="main-logo">
  </div>

  <div class="bulb-wrapper">
    <div class="speech-bubble" id="welcomeText">
      Viel Spaß beim Suchen!
    </div>
    <div class="bulb-container">
      <img src="Glühbirne_Begrüßung.png" alt="Glühbirne">
    </div>
  </div>

  <div class="dark-overlay" id="overlay"></div>
  <div class="light-cone" id="cone"></div>
  <div class="flashlight-spot" id="spot"></div>
  <div class="flashlight-tool" id="tool"></div>

  <a href="index.html" class="home-link">
    <img src="home weiß neu.png" alt="Home" width="100" height="200" class="home-icon">
  </a>

  <img src="Stern.png" id="item-seestern" class="item" data-name="Seestern" style="top: 75%; left: 35%; width: 110px;">
  <img src="krake.png" id="item-oktopus" class="item" data-name="Oktopus" style="top: 10%; left: 75%; width: 140px;">
  <img src="fisch.png" id="item-objekt3" class="item" data-name="Fisch" style="top: 38%; left: 50%; width: 90px;">
  <img src="koralle.png" id="item-objekt4" class="item" data-name="Koralle" style="top: 65%; left: 15%; width: 100px;">
  <img src="Objekt5.png" id="item-objekt5" class="item" data-name="Schatz" style="top: 75%; left: 40%; width: 120px;">

  <div class="switch" id="switch">
    <div class="toggle"></div>
  </div>

  <div class="score-wrapper">
    <div class="field" id="field-seestern"><img src="Stern.png" alt="Suche Seestern"></div>
    <div class="field" id="field-oktopus"><img src="krake.png" alt="Suche Oktopus"></div>
    <div class="field" id="field-objekt3"><img src="fisch.png" alt="Suche Objekt 3"></div>
    <div class="field" id="field-objekt4"><img src="koralle.png" alt="Suche Objekt 4"></div>
    <div class="field" id="field-objekt5"><img src="Objekt5.png" alt="Suche Objekt 5"></div>
    <div class="field"></div>
    <div class="field"></div>
    <div class="field"></div>
  </div>

</div>

<script>
  const container = document.getElementById("game-container");
  const overlay = document.getElementById("overlay");
  const spot = document.getElementById("spot");
  const tool = document.getElementById("tool");
  const cone = document.getElementById("cone");
  const switchBtn = document.getElementById("switch");
  const items = document.querySelectorAll(".item");
  const welcomeText = document.getElementById("welcomeText"); 

  let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2;
  let currentX = mouseX, currentY = mouseY;
  let isLightOn = false;

  window.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function update() {
    currentX += (mouseX - currentX) * 0.15;
    currentY += (mouseY - currentY) * 0.15;

    container.style.setProperty("--x", currentX + "px");
    container.style.setProperty("--y", currentY + "px");

    if (!isLightOn) {
      items.forEach(item => {
        if (item.classList.contains("found")) return;
        const rect = item.getBoundingClientRect();
        const dx = currentX - (rect.left + rect.width / 2);
        const dy = currentY - (rect.top + rect.height / 2);
        const distance = Math.sqrt(dx * dx + dy * dy);
        item.style.opacity = (distance < 140) ? 1 : 0;
      });
    }
    requestAnimationFrame(update);
  }
  update();

  switchBtn.addEventListener("click", () => {
    isLightOn = !isLightOn;
    overlay.classList.toggle("off", isLightOn);
    spot.classList.toggle("off", isLightOn);
    tool.classList.toggle("off", isLightOn);
    cone.classList.toggle("off", isLightOn);
    switchBtn.classList.toggle("on", isLightOn);

    items.forEach(item => {
      item.style.opacity = isLightOn ? 1 : (item.classList.contains("found") ? 0 : 0);
    });
  });

  items.forEach(item => {
    item.addEventListener("click", () => {
      if (!item.classList.contains("found")) {
        const rect = item.getBoundingClientRect();
        const dx = currentX - (rect.left + rect.width / 2);
        const dy = currentY - (rect.top + rect.height / 2);
        
        if (isLightOn || Math.sqrt(dx * dx + dy * dy) < 140) {
          item.classList.add("found");
          
          if (item.id === "item-seestern") {
            document.getElementById("field-seestern").classList.add("filled");
            welcomeText.textContent = "Du hast den Seestern gefunden! Er lebt am Meeresgrund.";
          } else if (item.id === "item-oktopus") {
            document.getElementById("field-oktopus").classList.add("filled");
            welcomeText.textContent = "Klasse! Ein Oktopus. Er hat drei Herzen und ist super schlau!";
          } else if (item.id === "item-objekt3") {
            document.getElementById("field-objekt3").classList.add("filled");
            welcomeText.textContent = "Super! Du hast den Fisch entdeckt.";
          } else if (item.id === "item-objekt4") {
            document.getElementById("field-objekt4").classList.add("filled");
            welcomeText.textContent = "Sehr gut! Du hast eine schöne Koralle gefunden.";
          } else if (item.id === "item-objekt5") {
            document.getElementById("field-objekt5").classList.add("filled");
            welcomeText.textContent = "Fantastisch! Du hast das letzte Objekt aufgespürt.";
          }
        }
      }
    });
  });
</script>

</body>
</html>
